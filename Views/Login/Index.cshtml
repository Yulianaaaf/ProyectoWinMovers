@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Login - WinMovers</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="h-screen flex items-center justify-center bg-gradient-to-br from-cyan-700 to-blue-900">

    <div class="bg-white p-8 rounded-xl shadow-2xl w-96">

        <h2 class="text-2xl font-bold text-center text-gray-700 mb-6">
            WinMovers
        </h2>

        @if (ViewBag.Error != null)
        {
            <div class="bg-red-100 text-red-600 p-2 mb-4 rounded text-sm text-center">
                @ViewBag.Error
            </div>
        }

        <form method="post" action="/Login/IniciarSesion">

            <input type="email" name="correo" placeholder="Correo"
                   class="w-full mb-4 p-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500"
                   required />

            <input type="password" name="password" placeholder="Contraseña"
                   class="w-full mb-4 p-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500"
                   required />

            <button type="submit"
                    class="w-full bg-cyan-500 text-white p-3 rounded-lg hover:bg-cyan-600 transition">
                Iniciar Sesión
            </button>

        </form>

    </div>

</body>
</html>