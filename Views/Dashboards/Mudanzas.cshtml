@{
    Layout = null;
}

<div class="bg-white p-6 rounded-xl shadow">

    <div class="flex justify-between mb-4">
        <h2 class="text-xl font-bold">Mudanzas</h2>
        <button onclick="abrirModal()" class="bg-cyan-500 text-white px-4 py-2 rounded">Nuevo</button>
    </div>

    <table class="w-full text-sm">
        <thead class="bg-gray-100">
            <tr>
                <th class="p-3">Cliente</th>
                <th class="p-3">Origen</th>
                <th class="p-3">Destino</th>
                <th class="p-3">Fecha</th>
                <th class="p-3">Estado</th>
                <th class="p-3">Acciones</th>
            </tr>
        </thead>
        <tbody id="tabla">
            <tr>
                <td colspan="6" class="text-center p-6 text-gray-400">Sin registros</td>
            </tr>
        </tbody>
    </table>
</div>

<div id="modal" 
     class="hidden fixed inset-0 bg-black bg-opacity-50 
            flex justify-center items-center"
     onclick="cerrarModalFuera(event)">

    <div class="bg-white p-6 rounded w-96 relative">

        <!-- BOTÓN X -->
        <button onclick="cerrarModal()" 
                class="absolute top-2 right-2 text-gray-500 hover:text-red-500">
            ✖
        </button>

        <h2 class="text-lg font-bold mb-4">
            Nueva Mudanza
        </h2>

        <input id="cliente" placeholder="Cliente" 
               class="border p-2 w-full mb-2">

        <input id="origen" placeholder="Origen" 
               class="border p-2 w-full mb-2">

        <input id="destino" placeholder="Destino" 
               class="border p-2 w-full mb-2">

        <input id="fecha" type="date" 
               class="border p-2 w-full mb-3">

        <div class="flex gap-2">

            <button onclick="cerrarModal()" 
                    class="bg-gray-300 px-4 py-2 rounded w-full">
                Cancelar
            </button>

            <button onclick="guardar()" 
                    class="bg-cyan-500 text-white px-4 py-2 rounded w-full">
                Guardar
            </button>
        </div>
    </div>

</div>

<script>
    let data = [];

    function abrirModal(){ modal.classList.remove("hidden"); }
    function cerrarModal(){ modal.classList.add("hidden"); }

    function guardar(){
        data.push({
            cliente: cliente.value,
            origen: origen.value,
            destino: destino.value,
            fecha: fecha.value,
            estado: "Pendiente"
        });
        render();
        cerrarModal();
    }

    function render(){
        let html = "";
        data.forEach((d,i)=>{
            html += `
            <tr>
                <td class="p-3">${d.cliente}</td>
                <td class="p-3">${d.origen}</td>
                <td class="p-3">${d.destino}</td>
                <td class="p-3">${d.fecha}</td>
                <td class="p-3">${d.estado}</td>
                <td class="p-3"><button onclick="eliminar(${i})">❌</button></td>
            </tr>`;
        });
        tabla.innerHTML = html;
    }

    function eliminar(i){
        data.splice(i,1);
        render();
    }

    function cerrarModalFuera(event){
    if(event.target.id === "modal"){
        cerrarModal();
    }
}
</script>