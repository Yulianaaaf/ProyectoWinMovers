@{
    Layout = null;
}

<div class="bg-white p-6 rounded-xl shadow">

    <div class="flex justify-between mb-4">
        <h2 class="text-xl font-bold">Empleados</h2>
        <button onclick="abrirModal()" class="bg-cyan-500 text-white px-4 py-2 rounded">Nuevo</button>
    </div>

    <table class="w-full text-sm">
        <thead class="bg-gray-100">
            <tr>
                <th class="p-3">Nombre</th>
                <th class="p-3">Cargo</th>
                <th class="p-3">Correo</th>
                <th class="p-3">Acciones</th>
            </tr>
        </thead>
        <tbody id="tabla">
            <tr><td colspan="4" class="text-center p-6 text-gray-400">Sin registros</td></tr>
        </tbody>
    </table>
</div>

<div id="modalEmpleado"
     class="hidden fixed inset-0 bg-black bg-opacity-50 flex justify-center items-center">

    <div class="bg-white p-6 rounded w-96">

        <h2 class="text-lg font-bold mb-3">
            Nuevo Empleado
        </h2>

        <input id="nombre"
               placeholder="Nombre"
               class="border p-2 w-full mb-2">

        <input id="cargo"
               placeholder="Cargo"
               class="border p-2 w-full mb-2">

        <input id="correo"
               placeholder="Correo"
               class="border p-2 w-full mb-2">

        <div class="flex justify-end gap-2 mt-3">

            <button onclick="cerrarModalEmpleado()"
                    class="bg-gray-300 px-4 py-2 rounded">
                Cancelar
            </button>

            <button onclick="guardarEmpleado()"
                    class="bg-cyan-500 text-white px-4 py-2 rounded">
                Guardar
            </button>
        </div>
    </div>
</div>

<script>

    let empleados = [];

    function abrirModalEmpleado() {
        document.getElementById("modalEmpleado")
            .classList.remove("hidden");
    }

    function cerrarModalEmpleado() {
        document.getElementById("modalEmpleado")
            .classList.add("hidden");

        limpiarCamposEmpleado();
    }

    // Cerrar haciendo click fuera
    document.getElementById("modalEmpleado")
        .addEventListener("click", function (e) {

        if (e.target === this) {
            cerrarModalEmpleado();
        }

    });

    function limpiarCamposEmpleado() {

        document.getElementById("nombre").value = "";
        document.getElementById("cargo").value = "";
        document.getElementById("correo").value = "";

    }

    function guardarEmpleado() {

        let nombre = document.getElementById("nombre").value;
        let cargo = document.getElementById("cargo").value;
        let correo = document.getElementById("correo").value;

        if (!nombre || !cargo || !correo) {
            alert("Completa todos los campos");
            return;
        }

        empleados.push({
            nombre,
            cargo,
            correo
        });

        renderEmpleados();
        cerrarModalEmpleado();
    }

    function renderEmpleados() {

        let tabla = document.getElementById("tabla");

        if (empleados.length === 0) {

            tabla.innerHTML = `
                <tr>
                    <td colspan="4"
                        class="text-center p-6 text-gray-400">
                        Sin registros
                    </td>
                </tr>
            `;

            return;
        }

        tabla.innerHTML = "";

        empleados.forEach((e, i) => {

            tabla.innerHTML += `
                <tr class="border-b">

                    <td class="p-3">
                        ${e.nombre}
                    </td>

                    <td class="p-3">
                        ${e.cargo}
                    </td>

                    <td class="p-3">
                        ${e.correo}
                    </td>

                    <td class="p-3 text-center">

                        <button onclick="eliminarEmpleado(${i})"
                                class="text-red-500 hover:underline">
                            Eliminar
                        </button>
                    </td>
                </tr>
            `;
        });
    }
    function eliminarEmpleado(index) {
        empleados.splice(index, 1);
        renderEmpleados();
    }
</script>