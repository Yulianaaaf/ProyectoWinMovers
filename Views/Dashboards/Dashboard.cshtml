<div class="space-y-6">

    <!-- HEADER + BOTONES -->
    <div class="flex justify-between items-center">
        <h2 class="text-2xl font-bold text-gray-700">Dashboard General</h2>

        <div class="flex gap-2">
            <button onclick="exportarPDF()" class="bg-red-500 text-white px-4 py-2 rounded shadow hover:bg-red-600">
                📄 Exportar PDF
            </button>

            <button onclick="exportarExcel()" class="bg-green-500 text-white px-4 py-2 rounded shadow hover:bg-green-600">
                📊 Exportar Excel
            </button>
        </div>
    </div>

    <!-- TARJETAS -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">

        <div class="bg-white p-5 rounded-xl shadow">
            <h3 class="text-gray-500">Clientes Registrados</h3>
            <p class="text-2xl font-bold">120</p>
        </div>

        <div class="bg-white p-5 rounded-xl shadow">
            <h3 class="text-gray-500">Cotizaciones</h3>
            <p class="text-2xl font-bold">45</p>
        </div>

        <div class="bg-white p-5 rounded-xl shadow">
            <h3 class="text-gray-500">Órdenes Activas</h3>
            <p class="text-2xl font-bold">18</p>
        </div>

        <div class="bg-white p-5 rounded-xl shadow">
            <h3 class="text-gray-500">Ingresos Totales</h3>
            <p class="text-2xl font-bold text-green-600">$25,000</p>
        </div>

    </div>

    <!-- CONTENIDO -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- ACTIVIDAD -->
        <div class="bg-white p-6 rounded-xl shadow">
            <h3 class="text-lg font-bold mb-4">Actividad Reciente</h3>

            <ul class="space-y-3 text-gray-600">
                <li>✔ Cliente registrado</li>
                <li>✔ Nueva cotización creada</li>
                <li>✔ Orden en progreso</li>
                <li>✔ Inventario actualizado</li>
            </ul>
        </div>

        <!-- RESUMEN -->
        <div class="bg-white p-6 rounded-xl shadow">
            <h3 class="text-lg font-bold mb-4">Resumen Operativo</h3>

            <div class="space-y-2">
                <div class="flex justify-between">
                    <span>Cotizaciones Pendientes</span>
                    <span class="font-bold">10</span>
                </div>

                <div class="flex justify-between">
                    <span>Inventario Total</span>
                    <span class="font-bold">320 ítems</span>
                </div>

                <div class="flex justify-between">
                    <span>Mudanzas en curso</span>
                    <span class="font-bold">8</span>
                </div>

                <div class="flex justify-between">
                    <span>Empleados activos</span>
                    <span class="font-bold">15</span>
                </div>
            </div>
        </div>

    </div>

</div>

<!-- LIBRERÍAS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<script>

    function exportarPDF() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();

        doc.text("Reporte WinMovers", 20, 20);
        doc.text("Clientes: 120", 20, 40);
        doc.text("Cotizaciones: 45", 20, 50);
        doc.text("Órdenes: 18", 20, 60);
        doc.text("Ingresos: $25,000", 20, 70);

        doc.save("reporte.pdf");
    }

    function exportarExcel() {

        const datos = [
            ["Métrica", "Valor"],
            ["Clientes", 120],
            ["Cotizaciones", 45],
            ["Órdenes", 18],
            ["Ingresos", 25000]
        ];

        const hoja = XLSX.utils.aoa_to_sheet(datos);
        const libro = XLSX.utils.book_new();

        XLSX.utils.book_append_sheet(libro, hoja, "Reporte");

        XLSX.writeFile(libro, "reporte.xlsx");
    }

</script>